# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env örneği commit edilebilir
!.env.example

# yerel SQLite veritabanı
/prisma/*.db
/prisma/*.db-journal

# prisma client çıktısı
/src/generated/

/src/generated/prisma

# Supabase veritabanı şifresi (yerel)
/.supabase-db-password

# Supabase CLI geçici dosyaları
/supabase/.temp/
