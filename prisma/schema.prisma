// Veri modeli — PROJE_PLANI.md §3
//
// Plandan bilinçli sapmalar:
// - Veritabanı: Supabase PostgreSQL. `genres` ve `emotions` SQLite döneminden kalma olarak JSON dizisi;
//   istenirse native dizilere (String[], Emotion[]) çevrilebilir.
// - İçerik kaynağı şimdilik TVmaze: `tvmazeId` alanları eklendi, `tmdbId` TMDB'ye geçişte doldurulacak.
// - Auth.js (NextAuth) için gereken Account/Session/VerificationToken modelleri ve
//   User üzerindeki name/emailVerified/image/passwordHash alanları eklendi. `image` = avatar.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TitleType {
  MOVIE
  SERIES
}

// WatchedEpisode.emotions / WatchedMovie.emotions JSON dizisindeki geçerli değerler
enum Emotion {
  HUZUNLU
  MUTLU
  HEYECANLI
  GERGIN
  KORKMUS
  SASKIN
  SINIRLI
  DUYGULANMIS
  SIKILMIS
  EGLENMIS
}

// ---------- Kullanıcı ve kimlik doğrulama ----------

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String? // avatar URL
  passwordHash  String? // Google ile girenlerde boş
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  watchedEpisodes WatchedEpisode[]
  watchedMovies   WatchedMovie[]
  comments        Comment[]
  commentLikes    CommentLike[]
  favorites       Favorite[]
  watchlist       WatchlistItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- İçerik (dış API önbelleği) ----------

model Title {
  id           String    @id @default(cuid())
  tmdbId       Int?
  tvmazeId     Int?      @unique
  imdbId       String?
  type         TitleType
  name         String
  overview     String?
  posterUrl    String?
  backdropUrl  String?
  imdbRating   Float?
  sourceRating Float? // içerik kaynağının (şimdilik TVmaze) kullanıcı puanı, 0-10
  runtime      Int? // film için dakika; dizide ortalama bölüm süresi
  releaseDate  DateTime?
  status       String? // ör. Running / Ended
  genres       Json      @default("[]") // string[]
  lastSyncedAt DateTime?

  seasons    Season[]
  comments   Comment[]
  watchedBy  WatchedMovie[]
  favorites  Favorite[]
  watchlists WatchlistItem[]

  @@unique([tmdbId, type])
}

model Season {
  id           String  @id @default(cuid())
  titleId      String
  seasonNumber Int
  name         String?
  posterUrl    String?

  title    Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([titleId, seasonNumber])
}

model Episode {
  id            String    @id @default(cuid())
  seasonId      String
  episodeNumber Int
  tvmazeId      Int?      @unique
  name          String
  overview      String?
  imdbId        String?
  imdbRating    Float?
  sourceRating  Float? // içerik kaynağının (şimdilik TVmaze) kullanıcı puanı, 0-10
  runtime       Int? // dakika
  airDate       DateTime?
  stillUrl      String?

  season    Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchedBy WatchedEpisode[]
  comments  Comment[]

  @@unique([seasonId, episodeNumber])
}

// ---------- İzleme takibi ----------

model WatchedEpisode {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  rating    Int? // 1-10
  emotions  Json     @default("[]") // Emotion[]
  note      String? // kişisel not (sadece kullanıcı görür)
  watchedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

model WatchedMovie {
  id        String   @id @default(cuid())
  userId    String
  titleId   String
  rating    Int?
  emotions  Json     @default("[]") // Emotion[]
  note      String?
  watchedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
}

// ---------- Yorumlar ----------

model Comment {
  id        String   @id @default(cuid())
  userId    String
  episodeId String? // bölüm yorumu
  titleId   String? // film yorumu (veya dizi geneli)
  content   String
  isSpoiler Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode?      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title   Title?        @relation(fields: [titleId], references: [id], onDelete: Cascade)
  likes   CommentLike[]

  @@index([episodeId])
  @@index([titleId])
}

model CommentLike {
  userId    String
  commentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

// ---------- Listeler ----------

model Favorite {
  userId    String
  titleId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([userId, titleId])
}

model WatchlistItem {
  userId  String
  titleId String
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([userId, titleId])
}
