// Veri modeli — PROJE_PLANI.md §3
//
// Plandan bilinçli sapmalar:
// - Veritabanı: Supabase PostgreSQL. Kimlik doğrulama Supabase Auth'ta (auth.users);
//   `User` uygulamanın profil tablosudur ve id'si auth.users.id ile aynıdır. Profil satırı
//   auth.users'a eklenen her kullanıcı için veritabanı tetikleyicisiyle oluşturulur/silinir.
// - İçerik kaynağı TMDB (+ IMDb puanları için OMDb). `tvmazeId` alanları ilk kaynaktan (TVmaze) kalma;
//   bölümler TMDB ile (sezon, bölüm no) üzerinden eşleşir.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TitleType {
  MOVIE
  SERIES
}

enum Emotion {
  HUZUNLU
  MUTLU
  HEYECANLI
  GERGIN
  KORKMUS
  SASKIN
  SINIRLI
  DUYGULANMIS
  SIKILMIS
  EGLENMIS
}

// ---------- Kullanıcı ve kimlik doğrulama ----------

// Profil — id = auth.users.id (Supabase Auth). Şifre ve oturumlar Supabase Auth'ta tutulur.
model User {
  id                    String   @id
  username              String   @unique
  email                 String   @unique
  avatarUrl             String? // Supabase Storage "avatars" kovasındaki fotoğraf
  isPrivate             Boolean  @default(false) // gizli profil: profil sayfası ve akış yalnızca sahibine açık
  coverPath             String? // profil kapağı: izlediği bir dizi/filmin TMDB sahne görseli yolu (ör. /abc.jpg)
  coverPositionY        Int      @default(50) // kapağın dikey konumu: 0 = üstü, 100 = altı görünür
  coverCharacterTitleId String? // kapağın ikinci sayfası: seçilen karakterin dizisi/filmi (Title.id)
  coverCharacterCastId  Int? // ve oyuncunun TMDB kimliği (Title.castMembers içinden)
  createdAt             DateTime @default(now())

  watchedEpisodes   WatchedEpisode[]
  watchedMovies     WatchedMovie[]
  comments          Comment[]
  commentLikes      CommentLike[]
  favorites         Favorite[]
  watchlist         WatchlistItem[]
  pushSubscriptions PushSubscription[]
  following         Follow[]           @relation("follower")
  followers         Follow[]           @relation("following")
}

// ---------- İçerik (dış API önbelleği) ----------

model Title {
  id             String    @id @default(cuid())
  tmdbId         Int?
  tvmazeId       Int?      @unique
  imdbId         String?
  type           TitleType
  name           String
  overview       String?
  posterUrl      String?
  backdropUrl    String?
  imdbRating     Float?
  sourceRating   Float? // içerik kaynağının (şimdilik TVmaze) kullanıcı puanı, 0-10
  runtime        Int? // film için dakika; dizide ortalama bölüm süresi
  releaseDate    DateTime?
  status         String? // ör. Running / Ended
  genres         String[]  @default([])
  lastSyncedAt   DateTime?
  imdbSyncedAt   DateTime? // OMDb puanlarının son çekildiği zaman
  castMembers    Json? // CastMember[] (src/lib/cast.ts): başrol oyuncuları ve karakterleri; null = henüz çekilmedi
  watchProviders Json? // WatchProviders (src/lib/providers.ts): Türkiye'de nerede izlenir; null = henüz çekilmedi

  seasons    Season[]
  comments   Comment[]
  watchedBy  WatchedMovie[]
  favorites  Favorite[]
  watchlists WatchlistItem[]

  @@unique([tmdbId, type])
}

model Season {
  id           String  @id @default(cuid())
  titleId      String
  seasonNumber Int
  name         String?
  posterUrl    String?

  title    Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([titleId, seasonNumber])
}

model Episode {
  id            String    @id @default(cuid())
  seasonId      String
  episodeNumber Int
  tvmazeId      Int?      @unique // eski kaynak (TVmaze); TMDB'ye taşınan bölümlerde kalır
  tmdbId        Int? // TMDB bölüm kimliği; eşleştirme (sezon, bölüm no) ile yapılır
  name          String
  overview      String?
  imdbId        String?
  imdbRating    Float?
  sourceRating  Float? // içerik kaynağının (şimdilik TVmaze) kullanıcı puanı, 0-10
  runtime       Int? // dakika
  airDate       DateTime?
  stillUrl      String?

  season    Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchedBy WatchedEpisode[]
  comments  Comment[]

  @@unique([seasonId, episodeNumber])
}

// ---------- İzleme takibi ----------

model WatchedEpisode {
  id                String     @id @default(cuid())
  userId            String
  episodeId         String
  rating            Int? // 1-10
  emotions          Emotion[]  @default([])
  note              String? // kişisel not (sadece kullanıcı görür)
  favoriteCastId    Int? // favori karakter: oyuncunun TMDB kimliği (Title.castMembers içinden)
  favoriteCharacter String? // seçildiği andaki karakter adı
  watchedAt         DateTime   @default(now())
  rewatchedAt       DateTime[] @default([]) // tekrar izleme tarihleri; toplam izleme = 1 + bu listenin uzunluğu

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}

model WatchedMovie {
  id                String     @id @default(cuid())
  userId            String
  titleId           String
  rating            Int?
  emotions          Emotion[]  @default([])
  note              String?
  favoriteCastId    Int? // favori karakter: oyuncunun TMDB kimliği (Title.castMembers içinden)
  favoriteCharacter String? // seçildiği andaki karakter adı
  watchedAt         DateTime   @default(now())
  rewatchedAt       DateTime[] @default([]) // tekrar izleme tarihleri; toplam izleme = 1 + bu listenin uzunluğu

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
}

// ---------- Yorumlar ----------

model Comment {
  id        String   @id @default(cuid())
  userId    String
  episodeId String? // bölüm yorumu
  titleId   String? // film yorumu (veya dizi geneli)
  content   String
  isSpoiler Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode?      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title   Title?        @relation(fields: [titleId], references: [id], onDelete: Cascade)
  likes   CommentLike[]

  @@index([episodeId])
  @@index([titleId])
}

model CommentLike {
  userId    String
  commentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

// ---------- Bildirimler ----------

// Tarayıcı bildirim aboneliği (Web Push); bir kullanıcının her tarayıcısı ayrı bir satırdır
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Takip ----------

// followerId, followingId'yi takip ediyor
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// ---------- Listeler ----------

model Favorite {
  userId    String
  titleId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([userId, titleId])
}

model WatchlistItem {
  userId  String
  titleId String
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([userId, titleId])
}

// ---------- Arama önbelleği ----------

// TVmaze arama sonuçları (normalleştirilmiş sorgu başına). Vercel'de sunucu belleği örnekler arasında
// paylaşılmadığı için önbellek veritabanında tutulur.
model SearchCache {
  query     String   @id
  results   Json // SearchResult[] (imdbRating hariç)
  fetchedAt DateTime @default(now())
}
