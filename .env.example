# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e eklenmez.

# SQLite veritabanı dosyası (PostgreSQL'e geçişte: postgresql://kullanici:sifre@host:5432/db)
DATABASE_URL="file:./prisma/dev.db"

# Oturum şifreleme anahtarı — üretmek için: openssl rand -base64 32
AUTH_SECRET=""

# Google ile giriş (isteğe bağlı). Boş bırakılırsa Google butonu gösterilmez.
# https://console.cloud.google.com/apis/credentials → yönlendirme adresi: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# İleride (TMDB/OMDb'ye geçişte) kullanılacak — şu an içerik TVmaze'den geliyor ve anahtar gerektirmiyor
TMDB_API_KEY=""
OMDB_API_KEY=""
