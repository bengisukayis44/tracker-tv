# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e eklenmez.

# Supabase PostgreSQL — Dashboard > Connect > ORMs/Prisma bölümündeki adresler
# Uygulama: transaction pooler (port 6543, sonunda ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.<proje-ref>:<şifre>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI / migration: session pooler (port 5432)
DIRECT_URL="postgresql://postgres.<proje-ref>:<şifre>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Oturum şifreleme anahtarı — üretmek için: openssl rand -base64 32
AUTH_SECRET=""

# Google ile giriş (isteğe bağlı). Boş bırakılırsa Google butonu gösterilmez.
# https://console.cloud.google.com/apis/credentials → yönlendirme adresi: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# İleride (TMDB/OMDb'ye geçişte) kullanılacak — şu an içerik TVmaze'den geliyor ve anahtar gerektirmiyor
TMDB_API_KEY=""
OMDB_API_KEY=""
