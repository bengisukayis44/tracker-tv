# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e eklenmez.

# Supabase PostgreSQL — Dashboard > Connect > ORMs/Prisma bölümündeki adresler
# Uygulama: transaction pooler (port 6543, sonunda ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.<proje-ref>:<şifre>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI / migration ve uçtan uca testlerin temizliği: session pooler (port 5432)
DIRECT_URL="postgresql://postgres.<proje-ref>:<şifre>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase Auth — Dashboard > Project Settings > API Keys. Publishable anahtar tarayıcıya açık olabilir.
NEXT_PUBLIC_SUPABASE_URL="https://<proje-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# IMDb puanları (https://www.omdbapi.com/apikey.aspx, ücretsiz: günde 1.000 istek). Boşsa IMDb puanı çekilmez.
OMDB_API_KEY=""

# Yalnızca uçtan uca testler için (test hesabı oluşturma). Uygulamada kullanılmaz; Vercel'e eklemeyin.
SUPABASE_SECRET_KEY=""
